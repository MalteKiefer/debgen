{
  "name": "debgen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/workbench/server.ts --outDir dist/.ssr",
    "build:site": "tsx scripts/build-site.ts",
    "build": "npm run generate:api && vue-tsc -b && npm run build:client && npm run build:ssr && npm run build:site",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "generate:api": "tsx scripts/generate-api.ts",
    "check": "npm run test:run && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "vue": "3.5.44",
    "vue-i18n": "11.4.14",
    "vuetify": "4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "sass": "1.105.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
