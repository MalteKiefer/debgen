{
  "name": "debgen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/workbench/server.ts --outDir dist/.ssr",
    "build:site": "tsx scripts/build-site.ts",
    "build": "npm run generate:api && vue-tsc -b && npm run build:client && npm run build:ssr && npm run build:site",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "generate:api": "tsx scripts/generate-api.ts",
    "check": "npm run test:run && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "highlight.js": "^11.12.0",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vuetify": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-dom": "3.5.42",
    "@vue/compiler-sfc": "3.5.42",
    "@vue/server-renderer": "3.5.42",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "30.0.1",
    "sass": "1.103.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
